{
  "name": "@erp/miniapp-ui",
  "version": "0.2.1",
  "description": "Design system and UI library for ERP mini apps",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coconut-ERP/erp-miniapp-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Coconut-ERP/erp-miniapp-ui/issues"
  },
  "homepage": "https://github.com/Coconut-ERP/erp-miniapp-ui#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "require": "./dist/cn.cjs"
    },
    "./styles.css": "./dist/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node ./scripts/copy-styles.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
